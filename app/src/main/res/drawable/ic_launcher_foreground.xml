        android:strokeWidth="2.5"
        android:strokeLineJoin="round" />
    <path
        android:pathData="M25.5,69.5 h9 v9 h-9 z"
        android:strokeColor="#1A1A1A"
        android:strokeWidth="2.5"
        android:strokeLineJoin="round" />

