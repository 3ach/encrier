    <!-- Strike through the first row's writing -->
    <path
        android:pathData="M40,33 L84,35.5"
        android:strokeColor="#1A1A1A"
        android:strokeWidth="2.5"
        android:strokeLineCap="round" />
    <path
        android:pathData="M42,54 c3,-5.5 7,-5.5 10,0 c3,5.5 7,5.5 10,0 c3,-5.5 7,-5.5 10,0 c3,5.5 7,5.5 10,0"
