    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Row separators -->
    <path
        android:pathData="M24,44.5 L84,44.5"
        android:strokeColor="#D4D4D4"
        android:strokeWidth="1.5" />
    <path
        android:pathData="M24,64.5 L84,64.5"
        android:strokeColor="#D4D4D4"
        android:strokeWidth="1.5" />

    <!-- Checkboxes -->
    <path
        android:pathData="M25.5,29.5 h9 v9 h-9 z"
        android:strokeColor="#1A1A1A"
        android:strokeWidth="2.5"
        android:strokeLineJoin="round" />
    <path
        android:pathData="M25.5,49.5 h9 v9 h-9 z"
